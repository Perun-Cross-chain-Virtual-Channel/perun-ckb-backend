.PHONY: dev stop clean-ready clean-artifacts

SENTINEL := .devnet-ready
READY_TIMEOUT ?= 600

clean-ready:
	@rm -f $(SENTINEL)

# clean-artifacts removes everything the devnet generates during a run so that a
# subsequent `make dev` starts from a pristine state (this is what avoids stale
# chain data and stale deployment code-hashes leaking across runs). It mirrors
# the cleanup setup-devnet.sh performs at startup, plus the deployment artifacts.
#
# It deliberately PRESERVES the persistent account fixtures (alice/bob/ingrid and
# their *_default variants) and tracked files (the scripts, sudt-celldep-template.json):
# no script regenerates alice/bob/ingrid, so deleting them would break the next run.
clean-artifacts:
	@echo "Cleaning devnet artifacts from previous run..."
	@# ckb node chain data + config generated by `ckb init` and the session.
	@rm -rf data specs system_scripts
	@rm -f ckb.toml ckb-miner.toml default.db-options
	@# Deployment + funding artifacts (regenerated by the next deploy).
	@rm -f info_0.json info_1.json info_vc.json fundingtx.json accounts.txt
	@rm -f deploy_*.log deploy_*_gen-txs.log
	@rm -rf contract/migrations_0/dev contract/migrations_1/dev contract/migrations_vc/dev
	@# Generated account material; alice/bob/ingrid fixtures are intentionally kept.
	@rm -f accounts/miner.pk accounts/miner.txt \
	       accounts/genesis-1.pk accounts/genesis-1.txt \
	       accounts/genesis-2.pk accounts/genesis-2.txt \
	       accounts/sudt-owner-lock-hash.txt \
	       accounts/sudt-owner-lock-hash1.txt accounts/sudt-owner-lock-hash2.txt
	@# ckb-cli keystore state (re-imported on the next run).
	@rm -rf $(HOME)/.ckb-cli $(HOME)/.ckb/keystore
	@# offckb's own rocksdb chain data (honour XDG_DATA_HOME like setup-devnet.sh).
	@OFFCKB_DEVNET_DIR="$${XDG_DATA_HOME:-$$HOME/.local/share}/offckb-nodejs/devnet"; \
	  rm -rf "$$OFFCKB_DEVNET_DIR/data"
	@rm -f $(SENTINEL)

dev: clean-ready
	go run -tags getaddress ../cmd/get_address.go
	tmuxp load -d ./devnet-session.yaml
	@echo "Waiting up to $(READY_TIMEOUT)s for devnet to become ready..."
	@i=0; while [ $$i -lt $(READY_TIMEOUT) ]; do \
	  if [ -f $(SENTINEL) ]; then \
	    echo "Devnet ready (after $${i}s)."; \
	    exec tmux a -t devnet; \
	  fi; \
	  i=$$((i+1)); sleep 1; \
	done; \
	echo "Devnet failed to become ready in $(READY_TIMEOUT)s" >&2; \
	tmux capture-pane -t devnet -p -S -200 || true; \
	exit 1

stop:
	@echo "Stopping devnet..."
	@tmux kill-session -t devnet 2>/dev/null || true
	@pkill -INT -f 'offckb-nodejs/bins.*/ckb' 2>/dev/null || true
	@pkill -INT -f 'offckb node' 2>/dev/null || true
	@sleep 3
	@pkill -KILL -f 'offckb-nodejs/bins.*/ckb' 2>/dev/null || true
	@pkill -KILL -f 'offckb node' 2>/dev/null || true
	@$(MAKE) --no-print-directory clean-artifacts
	@echo "Devnet stopped."
